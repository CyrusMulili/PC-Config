rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Reusable Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity-Specific Schema Validators
    function isValidUserProfile(data) {
      return data.userId is string 
        && data.userId == request.auth.uid
        && data.displayName is string 
        && data.displayName.size() <= 128
        && data.email is string 
        && data.email.size() <= 256
        && data.photoURL is string 
        && data.photoURL.size() <= 512
        && data.createdAt == request.time
        && data.keys().hasAll(['userId', 'displayName', 'email', 'photoURL', 'createdAt'])
        && data.keys().size() == 5;
    }

    function isValidPCBuild(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.userId is string
        && data.userId == request.auth.uid
        && data.buildName is string
        && data.buildName.size() <= 128
        && data.budgetKSh is number
        && data.budgetKSh > 0
        && data.budgetKSh <= 5000000
        && data.totalCostKSh is number
        && data.totalCostKSh > 0
        && data.useCase is string
        && data.useCase.size() <= 64
        && data.sourcingMode is string
        && data.sourcingMode.size() <= 64
        && data.components is list
        && data.components.size() <= 50 // Guarding against giant arrays
        && data.createdAt == (resource == null ? request.time : existing().createdAt) // Immortality guard
        && data.updatedAt == request.time
        && data.keys().hasAll(['id', 'userId', 'buildName', 'budgetKSh', 'totalCostKSh', 'useCase', 'sourcingMode', 'components', 'createdAt', 'updatedAt'])
        && data.keys().size() <= 12; // Allow optional keys ownedSpecs, chatHistory
    }

    // 4. Secure Path Match Blocks
    match /users/{userId} {
      allow get: if isOwner(userId);
      // No blanket list queries allowed for user profiles
      allow list: if false;

      allow create: if isOwner(userId) && isEmailVerified() && isValidUserProfile(incoming());
      
      allow update: if isOwner(userId) && isEmailVerified() && isValidUserProfile(incoming()) 
        && incoming().createdAt == existing().createdAt; // Immortal field check

      allow delete: if isOwner(userId);

      // Subcollection for saved PC builds
      match /builds/{buildId} {
        allow get: if isOwner(userId);
        
        // Enforce secure list queries. Client must filter where userId == auth.uid
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isEmailVerified() && isValidId(buildId) && isValidPCBuild(incoming());

        allow update: if isOwner(userId) && isEmailVerified() && isValidId(buildId) && isValidPCBuild(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt;

        allow delete: if isOwner(userId);
      }
    }
  }
}
